# Bu dosyayi '.env' olarak kopyalayin ve degerleri doldurun.
# .env dosyasi Git'e gonderilmez.

# python scripts/generate_secret.py ciktisi
SECRET_KEY=

# python scripts/set_password.py ciktisi
APP_PASSWORD_HASH=

# HTTPS arkasinda calisiyorsaniz 1 yapin
SECURE_COOKIE=0

# Veritabani dosyasinin bulundugu klasor (varsayilan: ./data)
# DATA_DIR=/veri/enerji
